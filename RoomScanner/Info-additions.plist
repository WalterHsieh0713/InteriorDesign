<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference only — do not add this as a second Info.plist file.
  In modern Xcode (Info tab generated from build settings), add this single
  key via target > Info > Custom iOS Target Properties > "+":

    Key:   Privacy - Camera Usage Description  (NSCameraUsageDescription)
    Value: This app uses the camera and LiDAR to scan your room.

  That one key is the only Info.plist change required. RoomPlan/ARKit will
  crash the app on launch of the scan screen if it's missing.
-->
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>This app uses the camera and LiDAR to scan your room.</string>
</dict>
</plist>
