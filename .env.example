# Copy to .env.local for local dev, and add the same keys in
# Vercel > Project > Settings > Environment Variables for prod.
# Never commit .env.local — create-next-app's default .gitignore already excludes it.

# --- Supabase (needed from Stage 2 on) ---
# Project > Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same page, "service_role" secret. Server-only — used in API routes to
# bypass RLS for uploads/writes. NEVER prefix this with NEXT_PUBLIC_ or it
# ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (needed from Stage 3 on) ---
# aistudio.google.com/apikey (or console.cloud.google.com if it's tied to a
# GCP project). Used via @google/genai for multimodal input + structured
# output (function calling) on the room-layout inference call.
GEMINI_API_KEY=
